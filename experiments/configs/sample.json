{
  "_comment": "示例配置。用法：python src/train.py --config sample.json  或  python src/evaluate.py --config sample.json",
  "scenario": "S1",
  "controller": "qlearning",
  "reward_fn": "diff-waiting-time",
  "episodes": 100,
  "seed": 0,
  "env": {
    "num_seconds": 3600,
    "delta_time": 5,
    "yellow_time": 3,
    "min_green": 5,
    "max_green": 50,
    "use_gui": false,
    "single_agent": true
  },
  "agent": {
    "alpha": 0.1,
    "gamma": 0.95,
    "epsilon": 1.0,
    "epsilon_min": 0.05,
    "epsilon_decay": 0.995
  },
  "discretizer": {
    "queue_edges": [0.1, 0.3, 0.6, 0.9],
    "density_edges": [0.1, 0.3, 0.6, 0.9]
  },
  "fixed_time": {
    "switch_every": 6
  }
}

