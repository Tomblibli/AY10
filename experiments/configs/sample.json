{
  "_comment": "示例配置：对照 plan.md / README 中的实验设置。当前代码读取常量与命令行参数，本文件作为参数留档。",
  "scenario": "S1",
  "controller": "qlearning",
  "reward_fn": "diff-waiting-time",
  "episodes": 100,
  "seed": 0,
  "env": {
    "num_seconds": 3600,
    "delta_time": 5,
    "yellow_time": 3,
    "min_green": 5,
    "max_green": 50,
    "use_gui": false,
    "single_agent": true
  },
  "agent": {
    "alpha": 0.1,
    "gamma": 0.95,
    "epsilon": 1.0,
    "epsilon_min": 0.05,
    "epsilon_decay": 0.995
  },
  "discretizer": {
    "queue_edges": [1, 3, 6, 10],
    "density_edges": [1, 3, 6, 10]
  }
}
